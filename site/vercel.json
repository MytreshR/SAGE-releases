{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v1/chat/completions",
      "destination": "/api/trial/chat"
    },
    {
      "source": "/resume-tailor",
      "destination": "https://sage-resume-tailor.vercel.app/resume-tailor"
    },
    {
      "source": "/resume-tailor/:path*",
      "destination": "https://sage-resume-tailor.vercel.app/resume-tailor/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/resume-tailor.html",
      "destination": "/resume-tailor",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "https://github.com/MytreshR/SAGE-releases/releases/latest/download/sage-1.3.1-setup.exe",
      "permanent": false
    },
    {
      "source": "/download/win",
      "destination": "https://github.com/MytreshR/SAGE-releases/releases/latest/download/sage-1.3.1-setup.exe",
      "permanent": false
    },
    {
      "source": "/download/mac",
      "destination": "https://github.com/MytreshR/SAGE-releases/releases/latest/download/sage-1.3.1-universal.dmg",
      "permanent": false
    }
  ]
}
